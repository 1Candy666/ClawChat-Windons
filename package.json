{
  "name": "clawchat",
  "version": "0.5.0",
  "description": "在 Windows 上和你的多个 AI 智能体单聊、拉群，并让它们动手干活",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . ClawChat --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=icon.ico --ignore=^/dist --ignore=^/docs --prune=true"
  },
  "keywords": [
    "ai",
    "agents",
    "group-chat",
    "electron",
    "codex",
    "deepseek",
    "windows"
  ],
  "author": "1Candy666",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3"
  },
  "productName": "ClawChat",
  "repository": {
    "type": "git",
    "url": "https://github.com/1Candy666/ClawChat-Windons"
  },
  "dependencies": {
    "unpdf": "^2.1.0"
  }
}
